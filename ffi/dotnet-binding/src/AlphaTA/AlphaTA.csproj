<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <RootNamespace>AlphaTA</RootNamespace>
    <AssemblyName>AlphaTA</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- v0.1.x keeps the historical AlphaTA .NET identity for compatibility
         while the repository and release train transition to Finkit. -->
    <PackageId>AlphaTA</PackageId>
    <Title>Finkit - .NET Bindings (AlphaTA compatibility package)</Title>
    <Version>0.1.0</Version>
    <Authors>Finkit Contributors</Authors>
    <Company>Finkit</Company>
    <Description>Finkit high-performance financial indicator and formula engine for .NET, powered by the Rust core. The AlphaTA package identity is retained for v0.1.x compatibility.</Description>
    <PackageTags>finkit;technical-analysis;finance;indicators;formula-engine;rsi;macd;moving-average;bollinger-bands;atr;alphata</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/coeasy/finkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/coeasy/finkit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) Finkit Contributors</Copyright>

    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stage alpha_ta_dotnet.dll next to the .NET assembly. -->
    <None Include="..\..\native\win-x64\native\*.dll" Pack="true"
          Condition="Exists('..\..\native\win-x64\native')">
      <Pack>true</Pack>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackagePath>runtimes\win-x64\native\</PackagePath>
    </None>
  </ItemGroup>

</Project>
