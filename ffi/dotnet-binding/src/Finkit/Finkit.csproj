<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <RootNamespace>Finkit</RootNamespace>
    <AssemblyName>Finkit</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PackageId>Finkit</PackageId>
    <Title>Finkit - .NET Bindings</Title>
    <Version>0.1.4</Version>
    <Authors>Finkit Contributors</Authors>
    <Company>Finkit</Company>
    <Description>High-performance financial technical analysis indicators library for .NET, powered by Rust.</Description>
    <PackageTags>technical-analysis;trading;finance;indicators;rsi;macd;moving-average;bollinger-bands;atr;stochastic;adx;finkit</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/coeasy/finkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/coeasy/finkit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) Finkit Contributors</Copyright>

    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md"
          Pack="true"
          PackagePath="README.md" />
  </ItemGroup>

  <!--
    Native libraries are staged at ffi/dotnet-binding/native/<rid>/native by
    the release workflow. Use MSBuildThisFileDirectory + forward slashes so
    packing behaves identically on Linux, Windows, and macOS runners. Explicit
    filenames in PackagePath avoid depending on directory-only Pack metadata.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../native/win-x64/native/*.dll"
          Pack="true"
          CopyToOutputDirectory="PreserveNewest"
          PackagePath="runtimes/win-x64/native/%(Filename)%(Extension)"
          Condition="Exists('$(MSBuildThisFileDirectory)../../native/win-x64/native')" />
    <None Include="$(MSBuildThisFileDirectory)../../native/linux-x64/native/*.so"
          Pack="true"
          CopyToOutputDirectory="PreserveNewest"
          PackagePath="runtimes/linux-x64/native/%(Filename)%(Extension)"
          Condition="Exists('$(MSBuildThisFileDirectory)../../native/linux-x64/native')" />
    <None Include="$(MSBuildThisFileDirectory)../../native/osx-x64/native/*.dylib"
          Pack="true"
          CopyToOutputDirectory="PreserveNewest"
          PackagePath="runtimes/osx-x64/native/%(Filename)%(Extension)"
          Condition="Exists('$(MSBuildThisFileDirectory)../../native/osx-x64/native')" />
    <None Include="$(MSBuildThisFileDirectory)../../native/osx-arm64/native/*.dylib"
          Pack="true"
          CopyToOutputDirectory="PreserveNewest"
          PackagePath="runtimes/osx-arm64/native/%(Filename)%(Extension)"
          Condition="Exists('$(MSBuildThisFileDirectory)../../native/osx-arm64/native')" />
  </ItemGroup>

</Project>
