{
  "name": "finkit",
  "version": "0.1.15",
  "description": "Rust-powered quantitative finance engine for indicators, formulas, factors, streaming analytics, and research workflows.",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/coeasy/finkit.git",
    "directory": "ffi/node-binding"
  },
  "homepage": "https://github.com/coeasy/finkit",
  "bugs": {
    "url": "https://github.com/coeasy/finkit/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Finkit Contributors",
  "keywords": [
    "quantitative-finance",
    "technical-analysis",
    "factor-research",
    "streaming",
    "financial-data",
    "indicators",
    "formula-engine",
    "napi-rs",
    "rust",
    "performance",
    "macd",
    "rsi",
    "bollinger-bands"
  ],
  "engines": {
    "node": ">= 16"
  },
  "napi": {
    "name": "finkit",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-unknown-linux-musl",
        "x86_64-unknown-linux-musl",
        "aarch64-pc-windows-msvc"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test test/basic.mjs",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "typescript": "^5.0.0"
  },
  "optionalDependencies": {
    "finkit-darwin-arm64": "0.1.15",
    "finkit-darwin-x64": "0.1.15",
    "finkit-linux-arm64-gnu": "0.1.15",
    "finkit-linux-arm64-musl": "0.1.15",
    "finkit-linux-x64-gnu": "0.1.15",
    "finkit-linux-x64-musl": "0.1.15",
    "finkit-win32-x64-msvc": "0.1.15",
    "finkit-win32-arm64-msvc": "0.1.15"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts"
  ]
}
